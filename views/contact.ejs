<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Joel Victor</title>
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/header') %>
  <main>
<section class="about-page">
  <div class="text-center mb-4">
    <h1><%= title %></h1>
    <p class="lead">
      I’m interested in opportunities in IT, networking, and cybersecurity.
      Feel free to connect with me or explore my work.
    </p>
  </div>

  <div class="row row-cols-1 row-cols-md-2 g-4">
    <div class="col">
      <section class="about-card h-100 d-flex flex-column align-items-start gap-3">
        <h2 class="mb-0">
          <i class="fa-brands fa-linkedin me-1" aria-hidden="true"></i>
          LinkedIn
        </h2>
        <p>Connect with me about internships, IT opportunities, or shared interests.</p>
        <a href="https://www.linkedin.com/in/joel-victor-b57396397/"
           class="projects-button mt-auto">
          Connect on LinkedIn
        </a>
      </section>
    </div>

    <div class="col">
      <section class="about-card h-100 d-flex flex-column align-items-start gap-3">
        <h2 class="mb-0">
          <i class="fa-brands fa-github me-1" aria-hidden="true"></i>
          GitHub
        </h2>
        <p>Browse my repositories and see how I built this portfolio.</p>
        <a href="https://github.com/joelvictor-ctrl"
           class="projects-button mt-auto">
          View my GitHub
        </a>
      </section>
    </div>
  </div>
  <section class="about-card mt-4">
  <h2>Send me a message</h2>
  <p class="mb-3">This form opens your email app so you can review and send your message.</p>

  <form action="mailto:joel.victor@ontariotechu.net"
        method="post" enctype="text/plain">
    <div class="mb-3">
      <label for="contact-name" class="form-label">Your name</label>
      <input id="contact-name" name="name" type="text"
             class="form-control" autocomplete="name" required>
    </div>

    <div class="mb-3">
      <label for="contact-email" class="form-label">Your email</label>
      <input id="contact-email" name="email" type="email"
             class="form-control" autocomplete="email" required>
    </div>

    <div class="mb-3">
      <label for="contact-message" class="form-label">Message</label>
      <textarea id="contact-message" name="message"
                class="form-control" rows="5" required></textarea>
    </div>

    <div class="mb-3">
      <label for="contact-check" class="form-label">What is 5 + 3?</label>
      <input id="contact-check" name="check" type="number"
             class="form-control" min="8" max="8" required>
    </div>

    <button type="submit" class="projects-button border-0">
      SUBMIT
    </button>
  </form>
<p class="mt-3 mb-0">
  <a href="mailto:joel.victor@ontariotechu.net">joel.victor@ontariotechu.net</a>.
</p>  
</section>
</section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>